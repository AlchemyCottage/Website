		<dc:creator><![CDATA[electric-i]]></dc:creator>
		<guid isPermaLink="false">https://alchemycottage.com/?post_type=recipe&#038;p=38</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>These cookies combine a brown-sugar dough with a white-sugar mix. Chill the dough before baking for thicker cookies.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p></p>
<!-- /wp:paragraph -->]]></content:encoded>
		<excerpt:encoded><![CDATA[Soft-centered cookies loaded with brown and white sugar, finished with a little optional flaky salt.]]></excerpt:encoded>
